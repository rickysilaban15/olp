# ==============================================================================
# OpenLocalPanel (OLP) - Template Konfigurasi Environment Oracle Database
# ==============================================================================
# PETUNJUK KEAMANAN & PENGGUNAAN:
# 1. Salin file template ini ke '.env' di root repositori:
#    cp .env.oracle.example .env
# 2. Atur izin akses file agar hanya dapat dibaca oleh pengguna pemilik proses OLP:
#    chmod 0600 .env
# 3. JANGAN PERNAH mengubah file template ini dengan secret nyata, dan
#    JANGAN PERNAH menambahkan file '.env' ke git commit.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MODE PENYIMPANAN DATA INTERNAL OLP
# ------------------------------------------------------------------------------
# Pilihan mode:
# - 'json'   : Mode default saat ini. Data tersimpan di ~/.olp/*.json.
#              (Gunakan mode ini pada Fase 1 & 2 untuk menjamin stabilitas tanpa cutover).
# - 'oracle' : Mode Oracle Database setelah migrasi skema dan cutover tervalidasi.
OLP_STORAGE_MODE=json

# ------------------------------------------------------------------------------
# 2. KREDENSIAL DAN KONEKSI ORACLE DATABASE FREE 23ai (APLIKASI)
# ------------------------------------------------------------------------------
# OLP berjalan secara native pada host Linux dan mengakses Oracle melalui
# container listener port 1521 yang terikat secara lokal (127.0.0.1).
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1

# Akun Database Khusus Aplikasi OLP (Prinsip Hak Akses Minimum / Least Privilege)
# PERINGATAN: DILARANG menggunakan akun SYS atau SYSTEM untuk koneksi aplikasi runtime!
ORACLE_USER=olp_app
ORACLE_PASSWORD=GANTI_DENGAN_PASSWORD_APLIKASI_ACAK_MIN_16_KARAKTER

# ------------------------------------------------------------------------------
# 3. SIKLUS HIDUP & CONNECTION POOL ORACLE (node-oracledb Thin Mode)
# ------------------------------------------------------------------------------
# Jumlah koneksi minimum yang selalu dipertahankan dalam pool
ORACLE_POOL_MIN=2
# Jumlah koneksi maksimum yang diizinkan dalam pool
ORACLE_POOL_MAX=10
# Pertambahan koneksi saat beban meningkat
ORACLE_POOL_INCREMENT=1
# Waktu idle (detik) sebelum koneksi tambahan dilepas kembali ke batas minimum
ORACLE_POOL_TIMEOUT=60
# Batas waktu tunggu koneksi awal dalam milidetik (fail-fast jika DB down)
ORACLE_CONNECT_TIMEOUT=10000

# ------------------------------------------------------------------------------
# 4. KUNCI MASTER ENKRIPSI RAHASIA (AES-256-GCM)
# ------------------------------------------------------------------------------
# Digunakan untuk mengenkripsi password koneksi database eksternal dan token Telegram
# yang tersimpan di dalam database internal.
#
# Format: String heksadesimal 64 karakter (32 bytes entropy).
# Buat kunci acak baru menggunakan perintah:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
#
# Opsi A: Menggunakan variabel lingkungan langsung
OLP_MASTER_KEY=GANTI_DENGAN_HEX_64_KARAKTER_DARI_RANDOM_BYTES_32

# Opsi B: Memuat kunci dari file terisolasi pada filesystem host (Direkomendasikan di Linux)
# Jika OLP_MASTER_KEY_FILE disetel dan file ada, nilai di file diutamakan.
# Contoh: /etc/olp/master.key dengan izin akses 'chmod 0400 /etc/olp/master.key'
# OLP_MASTER_KEY_FILE=/etc/olp/master.key

# ------------------------------------------------------------------------------
# 5. VARIABEL KHUSUS BOOTSTRAP CONTAINER DOCKER ORACLE (docker-compose.oracle.yml)
# ------------------------------------------------------------------------------
# Password administratif untuk akun SYS dan SYSTEM container Oracle.
# Hanya digunakan oleh container Oracle saat pertama kali membuat database (initialization).
# Tidak digunakan oleh aplikasi OLP secara langsung.
ORACLE_SYS_PASSWORD=GANTI_DENGAN_PASSWORD_SYS_ADMINISTRATIF_YANG_SANGAT_KUAT
